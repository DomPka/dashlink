<?xml version="1.0" encoding="utf-8"?>
<!-- Names for the views MainActivity builds in code, so Android can save their state and tests can find them. -->
<resources>
    <item name="status" type="id" />
    <item name="notice" type="id" />
    <item name="note" type="id" />
    <item name="select_all" type="id" />
    <item name="notice_action" type="id" />
    <item name="ssid" type="id" />
    <item name="pass" type="id" />
    <item name="connect" type="id" />
    <item name="folder" type="id" />
    <item name="rear" type="id" />
    <item name="refresh" type="id" />
    <item name="list" type="id" />
    <item name="progress" type="id" />
    <item name="download" type="id" />
    <item name="stop" type="id" />
    <item name="diag" type="id" />
    <!-- The state of the link in a word, next to its lens glyph. -->
    <item name="pill" type="id" />
    <!-- The live tile: the whole card, the text over the picture (and the reason under it when there is no picture),
         the LIVE / PAUSED chip, its title, the fps readout and its two buttons. -->
    <item name="live_tile" type="id" />
    <item name="live_state" type="id" />
    <item name="live_reason" type="id" />
    <item name="live_chip" type="id" />
    <item name="live_title" type="id" />
    <item name="live_readout" type="id" />
    <item name="live_open" type="id" />
    <item name="live_retry" type="id" />
    <!-- A clip row's thumbnail; tapping it opens the clip. -->
    <item name="thumb" type="id" />
    <!-- The download panel: the clip on its way and how far through the queue it is. -->
    <item name="panel_clip" type="id" />
    <item name="panel_count" type="id" />
</resources>
